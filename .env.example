# Stories by Surya — environment configuration
#
# Copy this file to `.env` and fill in the values from your Firebase project
# (Firebase console → Project settings → General → Your apps → Web app).
#
# These are the *publishable* Firebase web config values. They are safe to ship
# in a browser bundle. Never put private service-account keys in this file.
#
# The site runs without any of these: content falls back to the bundled starter
# structure, and anything that needs Firebase (sign-in, uploads, saving,
# enquiries) reports that it is not connected instead of pretending to work.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. When set, only this signed-in Firebase Auth account may use the
# dashboard. Leave empty to allow any account in the Firebase project.
VITE_ADMIN_EMAIL=
